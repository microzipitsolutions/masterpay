# ============================================================================
# MasterPay Backend — environment template
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5050

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterpay
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string used to sign JWTs. Generate e.g. `openssl rand -hex 48`.
JWT_SECRET=change_me_to_a_long_random_secret

# ── Seed accounts (created on first boot only, if the user doesn't exist) ────
# If left blank, the seed is skipped. No credentials are hardcoded in the code.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# ── Public URLs ─────────────────────────────────────────────────────────────
# Base URL of the hosted checkout page shown to customers.
CHECKOUT_BASE_URL=https://yourdomain.example
PUBLIC_BASE_URL=https://yourdomain.example
# Sandbox / test-mode checkout URL (optional; only for test mode).
SANDBOX_CHECKOUT_URL=

# ── Payout providers (FastAPI wallet backends) ──────────────────────────────
# Base URLs for the a24h / FirstPay / Survey payout providers. Per-merchant API
# keys live in the DB (withdrawal_merchant_configs), not here.
FIRSTPAY_BASE_URL=https://real.firstpay.example
SURVEY_BASE_URL=https://srv.firstpay.example
# Optional override used only by the sspay test harness.
SSPAY_TEST_OVERRIDE_URL=

# ── SS Accounting (double-entry ledger sync) ────────────────────────────────
SSACCT_BASE_URL=https://accounting.example
SSACCT_USERNAME=
SSACCT_PASSWORD=
SSACCT_ADMIN_ID=
# Set to "true" to sync ALL entries; otherwise only payins auto-sync.
LEDGER_FULL_SYNC=false

# ── Email / SMTP (alerts) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.example

# ── Feature flags ───────────────────────────────────────────────────────────
# Agent prepaid-wallet gate on payin creation. "false" disables it (payins
# are NOT gated on agent wallet balance). Default behaviour is ON when unset.
WALLET_GATE_ENABLED=false

# ── Merchant API integration (external platforms as MasterPay merchants,
#    e.g. TrustPay — Pay-In/Pay-Out webhook signing, retry, admin page) ──────
# Master kill-switch for the whole subsystem. "false" disables the admin
# endpoints and skips the auth-middleware JOINs entirely, falling back to
# pre-existing behaviour. Default behaviour is ON when unset.
MERCHANT_INTEGRATION_CONFIG_ENABLED=true
# Per-attempt webhook delivery timeout, in milliseconds.
WEBHOOK_TIMEOUT_MS=10000
# How often the background sweep checks for due webhook retries, in milliseconds.
WEBHOOK_RETRY_SWEEP_INTERVAL_MS=60000
# Maximum delivery attempts per webhook event before giving up (bounded
# exponential backoff: 1, 2, 5, 10, 30, 60 minutes).
WEBHOOK_MAX_RETRY_ATTEMPTS=6
